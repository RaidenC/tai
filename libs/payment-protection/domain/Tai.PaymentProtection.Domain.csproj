<Project Sdk="Microsoft.NET.Sdk" InitialTargets="EnsureOutputDirectory">

  <!-- Create bin directory before project evaluation to fix Linux glob pattern issue -->
  <Target Name="EnsureOutputDirectory">
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)" />
  </Target>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tai.PaymentProtection.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/domain/Tai.Portal.Core.Domain.csproj" />
  </ItemGroup>

</Project>
