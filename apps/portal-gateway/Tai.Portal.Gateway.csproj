<Project Sdk="Microsoft.NET.Sdk.Web" InitialTargets="EnsureOutputDirectory">

  <!-- Create bin directory before project evaluation to fix Linux glob pattern issue -->
  <Target Name="EnsureOutputDirectory">
    <MakeDir Directories="$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)" />
  </Target>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
